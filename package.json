{
  "name": "senku",
  "version": "0.1.0",
  "private": true,
  "description": "Typed JEV decision service for Kaseki-Agent, Soyuz, and Rusty-Fossil",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run validate:openapi && node --test scripts/wrangler-config.test.mjs scripts/audit-dependencies.test.mjs scripts/scorecard-workflow.test.mjs scripts/soyuz-simulator.test.ts",
    "test:soyuz-simulator": "node --test scripts/soyuz-simulator.test.ts",
    "test:coverage": "vitest run --coverage",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "validate:openapi": "vitest run --config vitest.openapi.config.ts",
    "contracts:generate": "tsx scripts/generate-profile-contracts.ts",
    "contracts:check": "vitest run test/profile-contract-artifact.test.ts",
    "validate:skills": "node --test scripts/skills.test.mjs",
    "perf:smoke": "vitest run --config vitest.performance.config.ts --reporter=verbose --maxWorkers=1",
    "smoke:provider": "vitest run --config vitest.provider-smoke.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@redocly/openapi-core": "2.78.0",
    "@utcp/http": "1.1.14",
    "@utcp/sdk": "1.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "fallow": "^3.47.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
