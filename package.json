{
  "name": "senku",
  "version": "0.1.0",
  "private": true,
  "description": "Typed JEV decision service for Kaseki-Agent and Soyuz",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf:smoke": "vitest run test/performance.smoke.test.ts --reporter=verbose",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
