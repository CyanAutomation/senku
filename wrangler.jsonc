{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senku",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "JEV_MODEL": "~typesafe/jev-latest",
    "SENKU_PROVIDER_TIMEOUT_MS": "15000",
    "SENKU_PUBLIC_BASE_URL": "https://service.example.invalid"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "ratelimits": [
    { "name": "SENKU_RATE_LIMIT_IP", "namespace_id": "73001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SENKU_RATE_LIMIT_KASEKI", "namespace_id": "73002", "simple": { "limit": 60, "period": 60 } },
    { "name": "SENKU_RATE_LIMIT_SOYUZ", "namespace_id": "73003", "simple": { "limit": 60, "period": 60 } },
    { "name": "SENKU_RATE_LIMIT_RUSTY_FOSSIL", "namespace_id": "73004", "simple": { "limit": 60, "period": 60 } }
  ]
}
