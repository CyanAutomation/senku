{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senku",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "vars": {
    "JEV_MODEL": "~typesafe/jev-latest",
    "SENKU_PROVIDER_TIMEOUT_MS": "15000",
    "SENKU_PUBLIC_BASE_URL": "https://senku.scheimann.workers.dev"
  },
  "limits": {
    "cpu_ms": 10,
    "subrequests": 1
  }
}
